# Foxbox Team — E-com Delivery Backend
# Copy this to .env and fill in your credentials

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# E-com Delivery API v2
ECOM_API_BASE_URL=https://ecom-dz.com/api_v2
ECOM_API_KEY=your_ecom_api_key
ECOM_API_TOKEN=your_ecom_api_token
# Webhook
ECOM_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Authentication (Optional - for production OAuth) ─────
# Google OAuth (console.cloud.google.com)
# VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Facebook OAuth (developers.facebook.com)
# VITE_FACEBOOK_APP_ID=your_facebook_app_id

# ─── YouCan Integration ─────────────────────────────────────
# Create a Partner app at: https://seller-area.youcan.shop
# 1. Create an App in Partner Dashboard
# 2. Uncheck "Embedded" in Configuration → Overview
# 3. Set Redirect URI: https://your-backend.workers.dev/api/youcan/oauth/callback
# 4. Scopes: read-orders, write-orders, read-products, read-customers, read-store-details, read-resthooks, write-resthooks

YOUCAN_CLIENT_ID=your_youcan_client_id
YOUCAN_CLIENT_SECRET=your_youcan_client_secret
YOUCAN_REDIRECT_URI=https://your-api.workers.dev/api/youcan/oauth/callback
YOUCAN_AUTH_URL=https://seller-area.youcan.shop/admin/oauth/authorize
YOUCAN_TOKEN_URL=https://api.youcan.shop/oauth/token
YOUCAN_API_BASE_URL=https://api.youcan.shop
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth

# ─── OpenAI (for AI text generation + fallback images) ────────
# Set your OpenAI API key here. Server-side only — never exposed to the browser.
# Used for GPT-4o-mini text generation and DALL-E 3 fallback image generation.
# OPENAI_API_KEY=sk-your-openai-api-key

# ─── FLUX Kontext (primary image generation) ──────────────────
# Black Forest Labs FLUX Kontext Pro via fal.ai
# Used for product-reference image generation (image-to-image).
# Get your key at: https://fal.ai/models/flux-kontext/pro
# FLUX_KONTEXT_API_KEY=your-fal-ai-key
